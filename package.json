{
  "name": "housetandem-web",
  "private": true,
  "scripts": {
    "test": "node --test test/links.test.js test/geo.test.mjs test/site-build.test.mjs",
    "links": "node tools/build-links.js",
    "check:links": "node tools/build-links.js --check",
    "build": "node tools/build-site.js",
    "build:staging": "node tools/build-site.js --env staging",
    "deploy:staging": "npm run build:staging && npx wrangler@4 deploy --env staging",
    "deploy:proxy": "npx wrangler@4 deploy -c workers/e-proxy/wrangler.toml",
    "sync-ui": "node tools/sync-ui.js",
    "check:ui": "node tools/sync-ui.js --check",
    "sync-identity": "node tools/sync-identity.js",
    "check:identity": "node tools/sync-identity.js --check"
  }
}
